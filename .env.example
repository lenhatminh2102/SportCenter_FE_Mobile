# Web / iOS simulator. Android emulator: http://10.0.2.2:5000
# Physical phone: replace localhost with your computer LAN IP, on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Google OAuth client IDs (public identifiers; never add a client secret)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional demo controls, hidden unless explicitly enabled. BE must use PAYMENT_MODE=mock.
EXPO_PUBLIC_ENABLE_PAYMENT_DEMO=false
